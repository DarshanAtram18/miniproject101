# Copy this file to .env and replace every placeholder before starting.
# Never commit .env or reuse example credentials in production.

APP_PORT=3000
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=profinsights
DB_USER=profinsights
DB_PASSWORD=replace-with-a-long-random-database-password
DB_POOL_SIZE=10

# Generate at least 48 random bytes; see README.md.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=12h

# Comma-separated exact browser origins. Docker local default is port 3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# One account with this email is promoted to Admin by migrations when it exists.
# On a clean database, use `npm run bootstrap-admin` once after migration.
ADMIN_EMAIL=admin@example.edu
ADMIN_NAME=System Administrator
ADMIN_DEPARTMENT=Computer Science and Engineering

# Do not store ADMIN_PASSWORD here. Supply it only for the one-time bootstrap command.
