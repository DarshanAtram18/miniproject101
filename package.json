{
  "name": "miniproject-api",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "render-build": "npm install --include=dev && npm --prefix client install --include=dev && npm --prefix client run build",
    "test": "node --test test/activity-domain.test.js test/report-service.test.js",
    "check": "npm test && npm --prefix client run lint && npm --prefix client run build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.1",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "brace-expansion": "^5.0.9"
  }
}
