          "requiresHost": true,
          "requiresScope": true,
          "roles": ["Author / Co-author", "Reviewer / Editor"],
          "fields": [
            { "name": "publicationType", "label": "Publication type", "type": "select", "required": true, "options": ["Journal article", "Conference paper", "Review article", "Other"] },
