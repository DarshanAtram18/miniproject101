            { "name": "awardName", "label": "Award / recognition", "type": "text", "required": true },
            { "name": "awardingBody", "label": "Awarding body", "type": "text", "required": true },
            { "name": "recipientName", "label": "Recipient", "type": "text", "required": true },
            { "name": "awardDate", "label": "Award date", "type": "date", "required": true }
