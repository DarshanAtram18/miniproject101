            { "name": "applicationNumber", "label": "Application / registration number", "type": "text" },
            { "name": "patentStatus", "label": "Current status", "type": "select", "required": true, "options": ["Filed", "Published", "Granted", "Commercialised", "In development"] },
            { "name": "filingDate", "label": "Filing / completion date", "type": "date" }
